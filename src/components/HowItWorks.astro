---
/** « Comment ça marche » : 4 étapes + formats (à distance / sur place) + CTA unique. */
import '../styles/conversion.css';
import { getContent, type Locale } from '../data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, ctas } = getContent(locale);
---

<section class="cv-section cv-steps" id="comment-ca-marche" aria-labelledby="cv-steps-title">
  <div class="container">
    <header class="cv-head">
      <p class="cv-eyebrow">{home.stepsEyebrow}</p>
      <h2 class="cv-title" id="cv-steps-title">{home.stepsTitle}</h2>
    </header>
    <ol class="cv-steps__list">
      {
        home.steps.map((step, i) => (
          <li class="cv-step">
            <span class="cv-step__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="cv-step__title">{step.title}</h3>
            <p class="cv-step__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="cv-formats">
      {
        home.formats.map((f) => (
          <article class="cv-format">
            <h3 class="cv-format__title">{f.title}</h3>
            <p class="cv-format__where">{f.where}</p>
            <p class="cv-format__body">{f.body}</p>
          </article>
        ))
      }
    </div>
    <div class="cv-actions">
      <a class="cv-btn cv-btn--primary" href={ctas.primaryHref} data-cursor="cta">
        {ctas.primary}
      </a>
      <p class="cv-reassure">{ctas.reassurance}</p>
    </div>
  </div>
</section>
