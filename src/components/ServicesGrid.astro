---
/**
 * Services décrits par la situation du client (jobs to be done) :
 * situation → service → résultat concret → lien vers la page service.
 */
import '../styles/conversion.css';
import { getContent, type Locale } from '../data';

interface Props {
  locale: Locale;
  /** Niveau du titre de section (h1 si la section porte la page) */
  headingLevel?: 'h1' | 'h2';
  id?: string;
}

const { locale, headingLevel = 'h2', id = 'services' } = Astro.props;
const { home } = getContent(locale);
const Heading = headingLevel;
---

<section class="cv-section cv-services" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="cv-head">
      <p class="cv-eyebrow">{home.servicesEyebrow}</p>
      <Heading class="cv-title" id={`${id}-title`}>{home.servicesTitle}</Heading>
      <p class="cv-lead">{home.servicesLead}</p>
    </header>
    <ul class="cv-services__grid">
      {
        home.services.map((s) => (
          <li class="cv-card">
            <p class="cv-card__situation">{s.situation}</p>
            <h3 class="cv-card__title">{s.title}</h3>
            <p class="cv-card__result">{s.result}</p>
            <a class="cv-card__link" href={s.href}>
              {home.servicesLinkLabel}
              <span class="visually-hidden"> : {s.title}</span>
              <span aria-hidden="true"> →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
