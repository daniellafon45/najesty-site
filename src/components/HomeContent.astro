---
/**
 * Contenu de la page d'accueil (FR + EN) — structure orientée clarté et conversion :
 * Hero (offre + CTA) → Services par situation → Comment ça marche → Projets →
 * Fondatrice → Magasins où l'on source → FAQ → Bandeau CTA final.
 */
import '../styles/conversion.css';
import Hero from './Hero';
import FeaturedCarousel from './FeaturedCarousel';
import ServicesGrid from './ServicesGrid.astro';
import HowItWorks from './HowItWorks.astro';
import FaqSection from './FaqSection.astro';
import SiteCtaBand from './SiteCtaBand.astro';
import SiteFooter from './SiteFooter.astro';
import { getContent, type Locale } from '../data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const { ctas, hero, home, atelier } = content;
const prefix = locale === 'en' ? '/en' : '';
const officialSite = locale === 'en' ? 'official site' : 'site officiel';
const featured = content.workItems.find((w) => w.size === 'featured')!;
const rest = content.workItems.filter((w) => w.size !== 'featured');
const gridSlots = [
  'work__item--lg',
  'work__item--md',
  'work__item--sm',
  'work__item--sm',
  'work__item--sm',
  'work__item--sm work__row-offset-left',
  'work__item--lg work__row-offset-right',
  'work__item--md',
  'work__item--sm work__row-offset-right-sm',
  'work__item--lg',
  'work__item--md',
  'work__item--sm work__row-offset-right-sm',
] as const;
const grid = rest.map((item, i) => ({
  item,
  className: gridSlots[i] ?? 'work__item--sm',
}));
---

<Hero
  client:load
  slides={content.heroSlides}
  headline={hero.headline}
  subline={hero.subline}
  eyebrow={hero.eyebrow}
  reassurance={hero.reassurance}
  slideLabel={hero.slideLabel}
  scrollLabel={content.ui.scrollVision}
  scrollHref="#services"
  primaryCta={ctas.primary}
  primaryHref={ctas.primaryHref}
  secondaryCta={ctas.secondary}
  secondaryHref={ctas.secondaryHref}
/>

<ServicesGrid locale={locale} />

<HowItWorks locale={locale} />

<section class="work cv-work" id="work" data-node-id="1:307" aria-labelledby="cv-work-title">
  <div class="container">
    <header class="cv-head">
      <p class="cv-eyebrow">{home.projectsEyebrow}</p>
      <h2 class="cv-title" id="cv-work-title">{home.projectsTitle}</h2>
      <p class="cv-lead">{home.projectsLead}</p>
    </header>
  </div>
  <div class="work__grid">
    <a
      class="work__item work__item--featured"
      href={`${prefix}/work`}
      id={`work-${featured.id}`}
      data-cursor="view"
      data-cursor-label={featured.name}
    >
      <div class="work__featured-copy">
        <h3 class="work__title">{featured.name}</h3>
        {
          featured.description && (
            <p class="work__desc work__desc--featured">{featured.description}</p>
          )
        }
      </div>
      <div class="work__frame">
        {
          featured.video ? (
            <FeaturedCarousel
              client:visible
              image={featured.image}
              video={featured.video}
              alt={featured.alt}
            />
          ) : (
            <img src={featured.image} alt={featured.alt} loading="eager" />
          )
        }
        <span class="work__go" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
            <path
              d="M5 12h12M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </div>
    </a>

    {
      grid.map(({ item, className }) => (
        <a
          class={`work__item ${className}`}
          href={`${prefix}/work/${item.id}`}
          id={`work-${item.id}`}
          data-cursor="view"
          data-cursor-label={item.name}
        >
          <div class="work__frame">
            <img src={item.image} alt={item.alt} loading="lazy" />
            <span class="work__go" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
                <path
                  d="M5 12h12M13 6l6 6-6 6"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
          <div class="work__meta">
            <h3 class="work__name">{item.name}</h3>
            {item.description && <p class="work__desc">{item.description}</p>}
          </div>
        </a>
      ))
    }
  </div>
  <div class="container cv-actions">
    <a class="cv-btn cv-btn--ghost" href={ctas.secondaryHref}>{ctas.secondary} →</a>
  </div>
</section>

<section class="cv-section cv-founder" id="fondatrice" aria-labelledby="cv-founder-title">
  <div class="container cv-founder__inner">
    <div class="cv-founder__media">
      <img
        src="/images/founder/eliahna-01-reflet.png"
        alt={home.founderImageAlt}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="cv-founder__copy">
      <p class="cv-eyebrow">{home.founderEyebrow}</p>
      <h2 class="cv-title" id="cv-founder-title">{home.founderTitle}</h2>
      {home.founderBody.map((para) => <p class="cv-founder__text">{para}</p>)}
      <a class="cv-card__link" href={`${prefix}/vision`}>
        {home.founderLink} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<section class="atelier cv-stores" aria-label={atelier.partnersLabel}>
  <div class="atelier__partners">
    <p class="atelier__partners-label">{atelier.partnersLabel}</p>
    <ul class="atelier__partners-list">
      {
        atelier.partners.map((partner) => (
          <li>
            <a
              href={partner.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${partner.name} (${officialSite})`}
            >
              <img
                src={partner.logo}
                alt=""
                loading="lazy"
                width={280}
                height={72}
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<FaqSection locale={locale} />

<SiteCtaBand
  title={ctas.bandTitle}
  body={ctas.bandBody}
  primary={ctas.primary}
  primaryHref={ctas.primaryHref}
  secondary={ctas.secondary}
  secondaryHref={ctas.secondaryHref}
/>

<SiteFooter locale={locale} />
