---
interface Props {
  title: string;
  body: string;
  primary: string;
  primaryHref: string;
  secondary?: string;
  secondaryHref?: string;
}

const { title, body, primary, primaryHref, secondary, secondaryHref } = Astro.props;
---

<section class="site-cta-band" aria-labelledby="site-cta-band-title">
  <div class="site-cta-band__inner container">
    <div class="site-cta-band__copy">
      <h2 id="site-cta-band-title">{title}</h2>
      <p>{body}</p>
    </div>
    <div class="site-cta-band__actions">
      <a class="site-cta-band__btn site-cta-band__btn--primary" href={primaryHref} data-cursor="cta">
        {primary}
      </a>
      {
        secondary && secondaryHref && (
          <a class="site-cta-band__btn site-cta-band__btn--ghost" href={secondaryHref}>
            {secondary}
          </a>
        )
      }
    </div>
  </div>
</section>
