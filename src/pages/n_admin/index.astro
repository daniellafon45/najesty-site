---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getFounderGallery } from '../../lib/admin/content';

const welcomePhotos = await getFounderGallery();
---

<AdminLayout title="Tableau de bord" active="dashboard">
  <section class="admin-welcome" aria-labelledby="admin-welcome-title">
    <div class="admin-welcome__photos" aria-hidden="true">
      {
        welcomePhotos.map((photo) => (
          <figure class="admin-welcome__frame">
            <img src={photo.src} alt="" loading="eager" width={320} height={400} />
          </figure>
        ))
      }
    </div>
    <div class="admin-welcome__copy">
      <p class="admin-welcome__eyebrow">Espace fondatrice</p>
      <h1 id="admin-welcome-title">Bonjour Eliahna</h1>
      <p class="admin-welcome__message">
        Bienvenue dans ton atelier numérique. Ici tu peux publier un blogue, ajouter des photos et
        faire vivre Najesty à ton rythme — avec le même soin que tu mets dans chaque espace.
      </p>
      <p class="admin-welcome__note">
        Prends une minute, respire, puis choisis ce que tu veux faire aujourd’hui.
      </p>
    </div>
  </section>

  <p class="admin-lead">Gérez les articles du site et la galerie photos (contenu dynamique via Cloudflare KV).</p>

  <div class="admin-card">
    <h2>Blogues</h2>
    <p>Voir et modifier tous les articles (contenu d’origine + ajouts). Une sauvegarde publie la version dynamique.</p>
    <p style="margin-top:1rem;">
      <a class="admin-btn" href="/n_admin/blog" style="color:#fff;-webkit-text-fill-color:#fff;">Ouvrir les blogues</a>
    </p>
  </div>

  <div class="admin-card">
    <h2>Photos</h2>
    <p>Téléverser des images (JPEG/PNG/WebP, max 2 Mo) et récupérer leur URL publique.</p>
    <p style="margin-top:1rem;">
      <a class="admin-btn" href="/n_admin/media" style="color:#fff;-webkit-text-fill-color:#fff;">Ouvrir les photos</a>
    </p>
  </div>
</AdminLayout>
