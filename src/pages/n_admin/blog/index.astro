---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAdminBlogPosts } from '../../../lib/admin/content';
import { readAdminSession } from '../../../lib/admin/auth';
import type { AdminBlogRow } from '../../../lib/admin/content';

const session = await readAdminSession(Astro.request);
const csrf = session?.csrf ?? '';
const frPosts = await listAdminBlogPosts('fr');
const enPosts = await listAdminBlogPosts('en');

function sourceLabel(source: AdminBlogRow['source'], lang: 'fr' | 'en') {
  if (lang === 'en') {
    if (source === 'static') return 'Static';
    if (source === 'override') return 'Edited';
    return 'KV';
  }
  if (source === 'static') return 'Site';
  if (source === 'override') return 'Modifié';
  return 'KV';
}
---

<AdminLayout title="Blogues" active="blog">
  <h1>Blogues</h1>
  <p class="admin-lead">
    Tous les articles du site (contenu d’origine + versions enregistrées en KV). Éditer un article
    « Site » le sauvegarde en dynamique sans toucher au code.
  </p>

  <p style="margin-bottom:1.5rem;">
    <a
      class="admin-btn"
      href="/n_admin/blog/edit"
      style="color:#fff;-webkit-text-fill-color:#fff;">Nouvel article FR</a
    >
  </p>

  <h2 style="margin:0 0 0.75rem;font-size:1.1rem;">Français ({frPosts.length})</h2>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Titre</th>
        <th>Slug</th>
        <th>Source</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {
        frPosts.length === 0 ? (
          <tr>
            <td colspan="4">Aucun article.</td>
          </tr>
        ) : (
          frPosts.map((p) => (
            <tr>
              <td>{p.title}</td>
              <td>
                <code>{p.slug}</code>
              </td>
              <td>
                <span class={`admin-tag admin-tag--${p.source}`}>{sourceLabel(p.source, 'fr')}</span>
              </td>
              <td class="admin-actions">
                <a
                  class="admin-btn admin-btn--ghost"
                  href={`/n_admin/blog/edit?locale=fr&slug=${p.slug}`}
                >
                  Éditer
                </a>
                {p.source !== 'static' && (
                  <button
                    type="button"
                    class="admin-btn admin-btn--danger js-delete-post"
                    data-locale="fr"
                    data-slug={p.slug}
                    data-static={p.source === 'override' ? '1' : '0'}
                  >
                    {p.source === 'override' ? 'Rétablir' : 'Supprimer'}
                  </button>
                )}
              </td>
            </tr>
          ))
        )
      }
    </tbody>
  </table>

  <h2 style="margin:2rem 0 0.75rem;font-size:1.1rem;">English ({enPosts.length})</h2>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Slug</th>
        <th>Source</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {
        enPosts.length === 0 ? (
          <tr>
            <td colspan="4">No posts.</td>
          </tr>
        ) : (
          enPosts.map((p) => (
            <tr>
              <td>{p.title}</td>
              <td>
                <code>{p.slug}</code>
              </td>
              <td>
                <span class={`admin-tag admin-tag--${p.source}`}>{sourceLabel(p.source, 'en')}</span>
              </td>
              <td class="admin-actions">
                <a
                  class="admin-btn admin-btn--ghost"
                  href={`/n_admin/blog/edit?locale=en&slug=${p.slug}`}
                >
                  Edit
                </a>
                {p.source !== 'static' && (
                  <button
                    type="button"
                    class="admin-btn admin-btn--danger js-delete-post"
                    data-locale="en"
                    data-slug={p.slug}
                    data-static={p.source === 'override' ? '1' : '0'}
                  >
                    {p.source === 'override' ? 'Revert' : 'Delete'}
                  </button>
                )}
              </td>
            </tr>
          ))
        )
      }
    </tbody>
  </table>

  <script define:vars={{ csrf }}>
    document.querySelectorAll('.js-delete-post').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const locale = btn.getAttribute('data-locale');
        const slug = btn.getAttribute('data-slug');
        const isOverride = btn.getAttribute('data-static') === '1';
        const msg = isOverride
          ? `Rétablir la version d’origine de ${slug} ?`
          : `Supprimer ${slug} ?`;
        if (!confirm(msg)) return;
        const res = await fetch('/api/admin/blog', {
          method: 'DELETE',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ csrf, locale, slug }),
        });
        if (res.ok) window.location.reload();
        else alert('Suppression impossible');
      });
    });
  </script>
</AdminLayout>
