---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listKvBlogPosts } from '../../../lib/admin/content';
import { readAdminSession } from '../../../lib/admin/auth';

const session = await readAdminSession(Astro.locals, Astro.request);
const csrf = session?.csrf ?? '';
const frPosts = await listKvBlogPosts(Astro.locals, 'fr');
const enPosts = await listKvBlogPosts(Astro.locals, 'en');
---

<AdminLayout title="Blogues" active="blog">
  <h1>Blogues (KV)</h1>
  <p class="admin-lead">Articles ajoutés depuis l’admin — en plus du contenu statique du site.</p>

  <p style="margin-bottom:1.5rem;">
    <a class="admin-btn" href="/n_admin/blog/edit">Nouvel article FR</a>
  </p>

  <h2 style="margin:0 0 0.75rem;font-size:1.1rem;">Français</h2>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Titre</th>
        <th>Slug</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {
        frPosts.length === 0 ? (
          <tr>
            <td colspan="3">Aucun article KV en français.</td>
          </tr>
        ) : (
          frPosts.map((p) => (
            <tr>
              <td>{p.title}</td>
              <td>
                <code>{p.slug}</code>
              </td>
              <td class="admin-actions">
                <a class="admin-btn admin-btn--ghost" href={`/n_admin/blog/edit?locale=fr&slug=${p.slug}`}>
                  Éditer
                </a>
                <button
                  type="button"
                  class="admin-btn admin-btn--danger js-delete-post"
                  data-locale="fr"
                  data-slug={p.slug}
                >
                  Supprimer
                </button>
              </td>
            </tr>
          ))
        )
      }
    </tbody>
  </table>

  <h2 style="margin:2rem 0 0.75rem;font-size:1.1rem;">English</h2>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Slug</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {
        enPosts.length === 0 ? (
          <tr>
            <td colspan="3">No KV posts in English.</td>
          </tr>
        ) : (
          enPosts.map((p) => (
            <tr>
              <td>{p.title}</td>
              <td>
                <code>{p.slug}</code>
              </td>
              <td class="admin-actions">
                <a class="admin-btn admin-btn--ghost" href={`/n_admin/blog/edit?locale=en&slug=${p.slug}`}>
                  Edit
                </a>
                <button
                  type="button"
                  class="admin-btn admin-btn--danger js-delete-post"
                  data-locale="en"
                  data-slug={p.slug}
                >
                  Delete
                </button>
              </td>
            </tr>
          ))
        )
      }
    </tbody>
  </table>

  <script define:vars={{ csrf }}>
    document.querySelectorAll('.js-delete-post').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const locale = btn.getAttribute('data-locale');
        const slug = btn.getAttribute('data-slug');
        if (!confirm(`Supprimer ${slug} ?`)) return;
        const res = await fetch('/api/admin/blog', {
          method: 'DELETE',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ csrf, locale, slug }),
        });
        if (res.ok) window.location.reload();
        else alert('Suppression impossible');
      });
    });
  </script>
</AdminLayout>
