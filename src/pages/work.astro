---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getContent } from '../data';

const content = getContent('fr');
const { workCategories, workFilters, workMeta, ui } = content;
---

<BaseLayout
  locale="fr"
  title={workMeta.title}
  description={workMeta.description}
  forceLightHeader
  activePath="/work"
>
  <main class="page-work" data-node-id="2:2">
    <header class="page-work__hero">
      <h1 class="page-work__marquee" aria-label={workMeta.heroMarquee.join(' · ')}>
        <span class="page-work__marquee-track">
          {
            [...workMeta.heroMarquee, ...workMeta.heroMarquee].map((phrase, i) => (
              <span aria-hidden={i >= workMeta.heroMarquee.length ? 'true' : undefined}>
                {phrase}
              </span>
            ))
          }
        </span>
      </h1>
      <div class="page-work__hero-copy container">
        <p class="page-work__hero-lead">{workMeta.heroLead}</p>
        <a class="page-work__hero-cta" href={workMeta.heroCtaHref}>
          {workMeta.heroCta} →
        </a>
        <p class="page-work__reassure">{content.ctas.reassurance}</p>
      </div>
    </header>

    <div class="page-work__layout container">
      <aside class="page-work__filters" aria-label={ui.filtersLabel}>
        <ul>
          {
            workFilters.map((f) => (
              <li>
                <a
                  href={f.href}
                  class={f.id === 'expertises' ? 'is-active' : undefined}
                  data-filter={f.id}
                >
                  {f.label}
                  {f.id === 'expertises' && (
                    <span class="page-work__filter-dots" aria-hidden="true" />
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>

      <div class="page-work__grid" id="work-grid">
        {
          workCategories.map((cat) => (
            <section class="page-work__cat" id={cat.id} data-node-id="2:51">
              <div class="page-work__cat-head">
                <h2>{cat.title}</h2>
                <a class="page-work__voir" href={`#${cat.id}`}>
                  {ui.see}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
              <div class="page-work__row">
                {cat.projects.map((p) => (
                  <a
                    class="page-work__card"
                    href={`/work/${p.id}`}
                    id={p.id}
                    data-cursor="view"
                    data-cursor-label={p.name}
                  >
                    <div class="page-work__frame">
                      <img src={p.image} alt={p.alt} loading="lazy" />
                    </div>
                    <h3>{p.name}</h3>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </main>

  <SiteFooter locale="fr" />
</BaseLayout>
